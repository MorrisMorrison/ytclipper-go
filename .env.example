# ytclipper-go Environment Configuration Example

# Server Configuration
YTCLIPPER_PORT=8080
YTCLIPPER_DEBUG=false

# Clips processed at the same time
YTCLIPPER_MAX_CONCURRENT_JOBS=3
# Queued plus processing jobs before clip requests get a 429 (default: 4 x MAX_CONCURRENT_JOBS)
YTCLIPPER_MAX_QUEUED_JOBS=12
# Longest clip range a request may ask for, in minutes (0 disables the check)
YTCLIPPER_MAX_CLIP_LENGTH_IN_MINUTES=30

# Basic Authentication (optional)
YTCLIPPER_AUTH_USERNAME=""
YTCLIPPER_AUTH_PASSWORD=""

# Video Processing Configuration
YTCLIPPER_YT_DLP_CLIP_SIZE_LIMIT_IN_MB=300
# Timeout for fetching video info (yt-dlp -J)
YTCLIPPER_YT_DLP_COMMAND_TIMEOUT_IN_SECONDS=60
# Timeout for downloading and cutting one clip
YTCLIPPER_YT_DLP_DOWNLOAD_TIMEOUT_IN_SECONDS=600
YTCLIPPER_YT_DLP_EXTRACTOR_RETRIES=3
# Route yt-dlp and ffmpeg through an HTTP proxy for a residential exit IP (optional).
# Must be HTTP (e.g. http://host:8118): ffmpeg, which downloads the clips, can't use SOCKS.
YTCLIPPER_YT_DLP_PROXY=""

# Rate Limiting Configuration
YTCLIPPER_RATE_LIMITER_RATE=5
YTCLIPPER_RATE_LIMITER_BURST=20
YTCLIPPER_RATE_LIMITER_EXPIRES_IN_MINUTES=1
# Behind a reverse proxy: its IPs/CIDRs, comma-separated. Only then is
# X-Forwarded-For trusted for the client IP (empty: the connection's address).
YTCLIPPER_TRUSTED_PROXIES=""

# Cleanup Scheduler Configuration
YTCLIPPER_CLIP_CLEANUP_SCHEDULER_ENABLED=true
YTCLIPPER_CLIP_CLEANUP_SCHEDULER_INTERVAL_IN_MINUTES=5
YTCLIPPER_CLIP_CLEANUP_SCHEDULER_RETENTION_IN_MINUTES=30
YTCLIPPER_CLIP_CLEANUP_SCHEDULER_CLIP_DIRECTORY_PATH="./videos"

### Complete Workflow - Step 1: Get Video Info
# Step 1: Get duration and formats of the target video
GET {{baseUrl}}/api/v1/video/info?youtubeUrl=https://www.youtube.com/watch?v=dQw4w9WgXcQ
Authorization: Basic {{basicAuth.username}} {{basicAuth.password}}

> {%
const info = response.body;
client.log("Video: " + info.title + " (" + info.duration + " s)");

// Prefer a 720p/1080p H.264 video-only format; the server merges best audio.
const video = info.formats.find(f => f.kind === "video" && f.vcodec.startsWith("avc1") && f.height <= 1080) || info.formats[0];
client.global.set("selectedFormat", video.id);
client.log("Selected format: " + video.id + " (" + video.note + ")");
%}

###

### Complete Workflow - Step 2: Create Clip
# Step 2: Create a clip using the selected format
POST {{baseUrl}}/api/v1/clip
Authorization: Basic {{basicAuth.username}} {{basicAuth.password}}
Content-Type: application/json

{
  "url": "https://www.youtube.com/watch?v=dQw4w9WgXcQ",
  "from": "00:00:10",
  "to": "00:00:30",
  "format": "{{selectedFormat}}"
}

> {%
client.global.set("workflowJobId", response.body);
client.log("Created job with ID: " + response.body);
%}

###

### Complete Workflow - Step 3: Check Job Status (Polling)
# Step 3: Check the job (run this until "status" is "completed" or "error")
GET {{baseUrl}}/api/v1/jobs/{{workflowJobId}}
Authorization: Basic {{basicAuth.username}} {{basicAuth.password}}

> {%
client.log("Job status: " + response.body.status + (response.body.error ? " (" + response.body.error + ")" : ""));
if (response.body.status === "completed") client.log("Download: " + response.body.downloadUrl);
%}

###

### Complete Workflow - Step 4: Download Clip
# Step 4: Download the completed clip (only run after job is completed)
GET {{baseUrl}}/api/v1/clip?jobId={{workflowJobId}}
Authorization: Basic {{basicAuth.username}} {{basicAuth.password}}

> {%
if (response.status === 200) {
  client.log("Successfully downloaded clip. Size: " + response.headers.valueOf("Content-Length") + " bytes");
} else {
  client.log("Failed to download clip. Status: " + response.status);
}
%}

###